# Set actual variables in your shell or Vercel; this file is documentation only.
ANALYSIS_MODE=mock
MOCK_SCENARIO=findings
# Required server-side for ANALYSIS_MODE=ai; no automatic .env loading.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# The free router can select different models; use a fixed model for repeatability.
# Optional comma-separated, exact extension origins after loading unpacked:
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
